{
  // Compiles the MCODE model + its tests to CommonJS under dist-test/, so they
  // can run on Node's built-in test runner (`node --test`) without extra deps.
  // The main tsconfig.json targets ESM for the webpack/Module Federation build;
  // this config is test-only.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist-test/",
    "rootDir": "./src/",
    "sourceMap": false,
    "noEmit": false,
    "types": ["node"]
  },
  // Only the test files; tsc pulls in their (pure) imports automatically. This
  // intentionally excludes the React hooks / web worker under src/model (e.g.
  // useMcodeWorker.ts uses import.meta, which can't compile to CommonJS).
  "files": [],
  "include": ["src/model/**/*.test.ts"]
}
