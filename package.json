{
  "name": "@cytoscape-web/mcode",
  "description": "MCODE App for Cytoscape Web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "webpack --config webpack.config.js --env production=true",
    "build-dev": "webpack --config webpack.config.js --env production=false",
    "dev": "webpack serve --open /remoteEntry.js --mode development",
    "test": "tsc -p tsconfig.test.json && node -e 'require(\"fs\").writeFileSync(\"dist-test/package.json\",JSON.stringify({type:\"commonjs\"}))' && node --test 'dist-test/**/*.test.js'"
  },
  "devDependencies": {
    "@module-federation/enhanced": "^2.6.0",
    "@mui/material": "^5.18.0",
    "@types/cytoscape": "^3.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.7.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.4"
  },
  "dependencies": {
    "@cytoscape-web/api-types": "^1.0.0-beta.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "cytoscape": "^3.34.0"
  },
  "peerDependencies": {
    "@mui/material": "^5.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
